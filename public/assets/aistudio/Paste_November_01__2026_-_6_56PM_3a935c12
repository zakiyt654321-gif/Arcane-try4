### `PerceptionSystem`
```javascript
const PerceptionSystem = {
    update(bot, dt) {
        // Clear visible enemies (reuse array)
        bot.perception.visibleEnemies.length = 0;
        
        // Query spatial hash for nearby entities
        const nearby = SPATIAL_GRID.query(bot.x, bot.y, bot.perception.range);
        
        for (let i = 0; i < nearby.length; i++) {
            const e = nearby[i];
            if (e === bot.entity || !e.isAlive) continue;
            if (hasLineOfSight(bot, e)) {
                bot.perception.visibleEnemies.push(e);
            }
        }
        
        // Update memory
        for (let i = 0; i < bot.perception.visibleEnemies.length; i++) {
            const e = bot.perception.visibleEnemies[i];
            bot.perception.lastKnownPositions[e.id] = {x: e.x, y: e.y, t: game.time};
        }
        
        // Decay
        for (const id in bot.perception.lastKnownPositions) {
            if (game.time - bot.perception.lastKnownPositions[id].t > 4.0) {
                delete bot.perception.lastKnownPositions[id];
            }
        }
    }
};
```

### `DecisionSystem`
```javascript
const DecisionSystem = {
    update(bot, dt) {
        if (game.time < bot.actionCommitUntil) return;  // committed
        
        // Score all actions
        let bestAction = 'WANDER';
        let bestScore = 0;
        
        for (let i = 0; i < ACTIONS.length; i++) {
            const score = scoreAction(bot, ACTIONS[i]);
            if (score > bestScore) {
                bestScore = score;
                bestAction = ACTIONS[i];
            }
        }
        
        bot.action = bestAction;
        bot.actionCommitUntil = game.time + bot.commitmentDuration;
    }
};
```

### `TacticsSystem`
```javascript
const TacticsSystem = {
    update(bot, dt) {
        switch (bot.action) {
            case 'ATTACK_MELEE': this._attackMelee(bot); break;
            case 'ATTACK_SPELL': this._attackSpell(bot); break;
            case 'APPROACH': this._approach(bot); break;
            case 'RETREAT': this._retreat(bot); break;
            // ... etc
        }
    },
    
    _attackSpell(bot) {
        const target = bot.perception.target;
        if (!target) return;
        
        if (bot.entity.mana < 20) return;  // not enough mana
        if (game.time < bot.entity.spellCdTime) return;
        
        // Predictive aim
        const angle = calculateAimAngle(bot, target, bot.entity.data.spellSpeed);
        bot.entity.facingAngle = angle;
        bot.entity.useSpell(game.time);
    },
    // ... etc
};
```

